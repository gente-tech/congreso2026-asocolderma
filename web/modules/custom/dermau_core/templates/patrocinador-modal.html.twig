<article class="du-sponsor-detail">

  <header class="du-sponsor-detail__header">

    <div class="du-sponsor-detail__logo-wrapper">
      {% if patrocinador.logo.url %}
        <img
          class="du-sponsor-detail__logo"
          src="{{ patrocinador.logo.url }}"
          alt="{{ patrocinador.logo.alt|default(patrocinador.nombre) }}"
        >
      {% else %}
        <div class="du-sponsor-detail__logo-placeholder">
          {{ patrocinador.nombre|slice(0, 1)|upper }}
        </div>
      {% endif %}
    </div>

    <div class="du-sponsor-detail__heading">

      <span class="du-sponsor-detail__eyebrow">
        Patrocinador del Congreso
      </span>

      <h2 class="du-sponsor-detail__title">
        {{ patrocinador.nombre }}
      </h2>

      <div class="du-sponsor-detail__badges">

        {% if patrocinador.stand %}
          <span class="du-sponsor-detail__badge">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 21C12 21 19 14.5 19 9A7 7 0 1 0 5 9C5 14.5 12 21 12 21Z"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <circle
                cx="12"
                cy="9"
                r="2.5"
                stroke="currentColor"
                stroke-width="1.8"
              />
            </svg>

            Stand No. {{ patrocinador.stand }}
          </span>
        {% endif %}

        {% if patrocinador.piso %}
          <span class="du-sponsor-detail__badge">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 21V6L12 3V21"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M12 9H20V21H12"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M7 8H9M7 12H9M7 16H9M15 12H17M15 16H17"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>

            {{ patrocinador.piso }}
          </span>
        {% endif %}

        <span class="du-sponsor-detail__badge">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="8"
              cy="8"
              r="3"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <circle
              cx="17"
              cy="9"
              r="2.5"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <path
              d="M3 20C3 16.7 5.2 14 8 14C10.8 14 13 16.7 13 20"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
            <path
              d="M14 15C17.5 14 21 16.2 21 20"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>

          Simposios vinculados:
          {{ patrocinador.eventos_count|default(0) }}    
        </span>

      </div>

      {#
      {% if patrocinador.ano_fundacion or patrocinador.ciudad %}
        <div class="du-sponsor-detail__metadata">

          {% if patrocinador.ano_fundacion %}
            <div class="du-sponsor-detail__metadata-item">
              <span class="du-sponsor-detail__metadata-label">
                Año de fundación
              </span>

              <strong>
                {{ patrocinador.ano_fundacion }}
              </strong>
            </div>
          {% endif %}

          {% if patrocinador.ciudad %}
            <div class="du-sponsor-detail__metadata-item">
              <span class="du-sponsor-detail__metadata-label">
                Ciudad
              </span>

              <strong>
                {{ patrocinador.ciudad }}
              </strong>
            </div>
          {% endif %}

        </div>
      {% endif %}
      #}

      {% if patrocinador.link.url %}
        <a
          class="du-sponsor-detail__website"
          href="{{ patrocinador.link.url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ patrocinador.link.title|default('Visitar sitio web') }}

          <span aria-hidden="true">↗</span>
        </a>
      {% endif %}

    </div>

  </header>

  {% if patrocinador.eventos %}
    <section class="du-sponsor-detail__section">
      <h3 class="du-sponsor-detail__section-title">
        Simposios Vinculados
      </h3>
    
      <div class="du-sponsor-detail__symposiums">

        {% for evento in patrocinador.eventos %}
          <a
            href="{{ evento.url }}"
            class="du-sponsor-symposium"
          >
            <div class="du-sponsor-symposium__tags">

              {% if evento.tipo %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--sponsored">
                  {{ evento.tipo }}
                </span>
              {% endif %}

              {% if evento.tematica %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--topic">
                  {{ evento.tematica }}
                </span>
              {% endif %}

              {% if evento.sala %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--room {{ evento.sala_class }}">
                  {{ evento.sala }}
                </span>
              {% endif %}

              {% if evento.fecha %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--date">
                  {{ evento.fecha }}
                </span>
              {% endif %}

              {% if evento.hora %}
                <span class="du-sponsor-symposium__time">
                  <span
                    class="du-icon__clock"
                    aria-hidden="true"
                  ></span>

                  {{ evento.hora }}
                </span>
              {% endif %}

            </div>

            <div class="du-sponsor-symposium__title">
              <strong>Conferencia:</strong>
              {{ evento.nombre }}
            </div>
          </a>
        {% endfor %}

      </div> 
    </section>
  {% endif %}

  {% if patrocinador.docentes %}
    <section class="du-sponsor-detail__section">
      <h3 class="du-sponsor-detail__section-title">
        Conferencistas Vinculados
      </h3>
    
      <div class="du-sponsor-detail__teachers">

        {% for docente in patrocinador.docentes %}
          <article class="du-sponsor-teacher">

            <div class="du-sponsor-teacher__header">

              <div class="du-sponsor-teacher__photo">
                {% if docente.foto.url %}
                  <img
                    src="{{ docente.foto.url }}"
                    alt="{{ docente.foto.alt|default(docente.nombre) }}"
                    loading="lazy"
                  >
                {% else %}
                  <div class="du-sponsor-teacher__placeholder">
                    {{ docente.nombre|slice(0, 1)|upper }}
                  </div>
                {% endif %}
              </div>

              <div class="du-sponsor-teacher__identity">
                <h4 class="du-sponsor-teacher__name">
                  {{ docente.nombre }}
                </h4>

                {% if docente.especialidad %}
                  <div class="du-sponsor-teacher__specialty">
                    {{ docente.especialidad }}
                  </div>
                {% endif %}

                {% if docente.pais %}
                  <div class="du-sponsor-teacher__country">
                    <strong>{{ docente.pais }}</strong>

                    {% if docente.pais_class %}
                      <span
                        class="du-icon__flag-{{ docente.pais_class }}"
                        title="{{ docente.pais }}"
                        aria-label="{{ docente.pais }}"
                      ></span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

            </div>

            {% if docente.perfil_resumen %}
              <p class="du-sponsor-teacher__profile">
                {{ docente.perfil_resumen }}
              </p>
            {% endif %}

            <a
              href="#conferencista-modal-{{ docente.id }}"
              class="du-sponsor-teacher__link js-conferencista-modal-open"
              data-modal-target="conferencista-modal-{{ docente.id }}"
              aria-haspopup="dialog"
              aria-controls="conferencista-modal-{{ docente.id }}"
            >
              Ver detalle
            </a>

          </article>
        {% endfor %}

      </div>    
    </section> 
  {% endif %}

  {# ============================================================
   MODALES DE CONFERENCISTAS
   Reutiliza la misma estructura visual de la agenda del nodo 98.
   ============================================================ #}

{% set salas = {
  'sala_1': 'Sala 1',
  'sala_2': 'Sala 2',
  'sala_3': 'Sala 3'
} %}

{% for docente_data in patrocinador.docentes %}

  {% set docente = docente_data.entity %}

  {% if docente
    and docente.getEntityTypeId() == 'node'
    and docente.bundle() == 'docente'
  %}

    {% set foto_item = docente.field_foto_docente.0 %}
    {% set foto_archivo = foto_item.entity %}
    {% set especialidad = docente.field_especialidad.entity %}
    {% set ciudad = docente.field_ciudad.entity %}
    {% set universidad = docente.field_universidad.entity %}

    {% set linkedin = docente.field_linkedin.0.url|default(null) %}
    {% set instagram = docente.field_instagram.0.url|default(null) %}
    {% set facebook = docente.field_facebook.0.url|default(null) %}
    {% set pagina_web = docente.field_pagina_web.value|default('')|trim %}

    {% if pagina_web %}
      {% set pagina_web_url = pagina_web starts with 'http'
        ? pagina_web
        : 'https://' ~ pagina_web
      %}
    {% else %}
      {% set pagina_web_url = null %}
    {% endif %}

    <dialog
      id="conferencista-modal-{{ docente.id() }}"
      class="du-conferencista-modal"
      aria-labelledby="conferencista-modal-title-{{ docente.id() }}"
    >
      <div class="du-conferencista-modal__surface">

        <button
          type="button"
          class="du-conferencista-modal__close"
          data-modal-close
          aria-label="Cerrar información de {{ docente.label }}"
        >
          <span aria-hidden="true">×</span>
        </button>

        <div class="du-conferencista-modal__layout">

          {# =========================
             COLUMNA IZQUIERDA
             ========================= #}
          <aside class="du-conferencista-modal__identity">

            <div class="du-conferencista-modal__photo">

              {% if foto_archivo %}
                <img
                  src="{{ file_url(foto_archivo.uri.value) }}"
                  alt="{{ foto_item.alt|default(docente.label) }}"
                  loading="lazy"
                  width="{{ foto_item.width|default(400) }}"
                  height="{{ foto_item.height|default(500) }}"
                >
              {% else %}
                <div class="du-conferencista-modal__photo-placeholder">
                  {{ docente.label|slice(0, 1)|upper }}
                </div>
              {% endif %}

            </div>

            <h2
              id="conferencista-modal-title-{{ docente.id() }}"
              class="du-conferencista-modal__name"
            >
              {{ docente.label }}
            </h2>

            {% if especialidad %}
              <div class="du-conferencista-modal__specialty">
                {{ especialidad.label }}
              </div>
            {% endif %}

            <div class="du-conferencista-modal__metadata">

              {% if docente_data.pais %}
                <div class="du-conferencista-modal__metadata-item">
                  <strong>País:</strong>

                  <span class="du-conferencista-modal__country">

                    {% if docente_data.pais_class %}
                      <span
                        class="du-icon__flag-{{ docente_data.pais_class }}"
                        aria-hidden="true"
                      ></span>
                    {% endif %}

                    {{ docente_data.pais }}
                  </span>
                </div>
              {% endif %}

              {% if ciudad %}
                <div class="du-conferencista-modal__metadata-item">
                  <strong>Ciudad:</strong>
                  <span>{{ ciudad.label }}</span>
                </div>
              {% endif %}

              {% if universidad %}
                <div class="du-conferencista-modal__metadata-item">
                  <strong>Universidad:</strong>
                  <span>{{ universidad.label }}</span>
                </div>
              {% endif %}

              {% if docente.field_correo_electronico.value %}
                <div class="du-conferencista-modal__metadata-item">
                  <strong>Correo:</strong>

                  <a href="mailto:{{ docente.field_correo_electronico.value }}">
                    {{ docente.field_correo_electronico.value }}
                  </a>
                </div>
              {% endif %}

            </div>

            {% if linkedin or instagram or facebook or pagina_web_url %}
              <div class="du-conferencista-modal__social">

                {% if linkedin %}
                  <a
                    href="{{ linkedin }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    LinkedIn
                  </a>
                {% endif %}

                {% if instagram %}
                  <a
                    href="{{ instagram }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Instagram
                  </a>
                {% endif %}

                {% if facebook %}
                  <a
                    href="{{ facebook }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Facebook
                  </a>
                {% endif %}

                {% if pagina_web_url %}
                  <a
                    href="{{ pagina_web_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Página web
                  </a>
                {% endif %}

              </div>
            {% endif %}

          </aside>

          {# =========================
             COLUMNA DERECHA
             ========================= #}
          <div class="du-conferencista-modal__content">

            <section class="du-conferencista-modal__section">

              <h3 class="du-conferencista-modal__section-title">
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M3 10L12 5L21 10L12 15L3 10Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M7 12V17C10 19 14 19 17 17V12"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                  <path
                    d="M21 10V16"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                </svg>

                Perfil profesional
              </h3>

              {% if docente.field_perfil_profesional.value %}
                <div class="du-conferencista-modal__profile">
                  {{ docente.field_perfil_profesional.value|nl2br }}
                </div>
              {% else %}
                <p class="du-conferencista-modal__empty">
                  Perfil profesional no disponible.
                </p>
              {% endif %}

            </section>

            <section class="du-conferencista-modal__section">

              <h3 class="du-conferencista-modal__section-title du-conferencista-modal__section-title--conferences">
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M4 5.5C4 4.67 4.67 4 5.5 4H11V19H5.5C4.67 19 4 19.67 4 20.5V5.5Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M20 5.5C20 4.67 19.33 4 18.5 4H13V19H18.5C19.33 19 20 19.67 20 20.5V5.5Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                </svg>

                Conferencias vinculadas
              </h3>

              <div class="du-conferencista-modal__events">

                {% set tiene_conferencias_vinculadas = false %}

                {% if agenda %}

                  {% for evento_item in agenda.field_listado_eventos_congreso %}

                    {% set evento_vinculado = evento_item.entity %}

                    {% if evento_vinculado %}

                      {% set sala_evento = evento_vinculado.field_sala_evento.value %}
                      {% set dia_evento = evento_vinculado.field_dia_evento.value %}

                      {% for conferencia_item in evento_vinculado.field_listado_conferencias %}

                        {% set conferencia_vinculada = conferencia_item.entity %}

                        {% if conferencia_vinculada %}

                          {% set docente_conferencia =
                            conferencia_vinculada.field_conferencista_conferencia.0.entity
                          %}

                          {% if docente_conferencia
                            and docente_conferencia.id() == docente.id()
                          %}

                            {% set tiene_conferencias_vinculadas = true %}

                            <a
                              href="{{ path(
                                'entity.node.canonical',
                                {'node': agenda.id()}
                              ) }}#simposio-{{ evento_vinculado.id() }}"
                              class="du-conferencista-event js-conferencista-event-link"
                            >

                              <div class="du-conferencista-event__tags">

                                {% if evento_vinculado.field_tipo_evento.entity %}
                                  <span class="du-conferencista-event__tag">
                                    {{ evento_vinculado.field_tipo_evento.entity.name.value }}
                                  </span>
                                {% endif %}

                                {% if evento_vinculado.field_tematica_evento.entity %}
                                  <span class="du-conferencista-event__tag du-conferencista-event__tag--orange">
                                    {{ evento_vinculado.field_tematica_evento.entity.name.value }}
                                  </span>
                                {% endif %}

                                {% if sala_evento %}
                                  <span class="du-conferencista-event__tag du-conferencista-event__tag--room">
                                    {{ salas[sala_evento]|default(sala_evento) }}
                                  </span>
                                {% endif %}

                                {% if dia_evento %}
                                  <span class="du-conferencista-event__date">
                                    {{ dia_evento|date('d/m/Y', 'UTC') }}
                                  </span>
                                {% endif %}

                                {% if conferencia_vinculada.field_hora_conferencia.value %}
                                  <span class="du-conferencista-event__time">

                                    <span
                                      class="du-icon__clock"
                                      aria-hidden="true"
                                    ></span>

                                    {{ conferencia_vinculada.field_hora_conferencia.value }}
                                  </span>
                                {% endif %}

                              </div>

                              <div class="du-conferencista-event__title">
                                <strong>Conferencia:</strong>
                                {{ conferencia_vinculada.field_titulo_conferencia.value }}
                              </div>

                            </a>

                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% if not tiene_conferencias_vinculadas %}
                  <p class="du-conferencista-modal__empty">
                    Sin conferencias vinculadas
                  </p>
                {% endif %}

              </div>

            </section>

          </div>
        </div>
      </div>
    </dialog>

  {% endif %}
{% endfor %}

  {% if patrocinador.ubicacion.url %}
    <section class="du-sponsor-detail__section">
      <h3 class="du-sponsor-detail__section-title">
        Ubicación stand
      </h3>

      <div class="du-sponsor-detail__location">
        <img
          src="{{ patrocinador.ubicacion.url }}"
          alt="{{ patrocinador.ubicacion.alt }}"
          loading="lazy"
        >
      </div>
    </section>
  {% endif %}

</article>
