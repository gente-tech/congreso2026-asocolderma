				<div class="du-error-404__actions">

					<a href="{{ path('<front>') }}" class="du-btn du-btn--primary du-error-404__button">
						Volver al inicio
					</a>

					<a href="{{ path('entity.node.canonical', {'node': 98}) }}" class="du-btn du-btn--secundary-dark du-error-404__button">
						Ir a la agenda
					</a>

				</div>

				<div class="du-error-404__congress">
					7° Congreso Colombiano de Especialidades Dermatológicas
				</div>

			</div>

		</div>

	</section>

</main>

{{ page.footer }}
