<article class="du-sponsor-detail">

  <header class="du-sponsor-detail__header">

    <h2 class="du-sponsor-detail__title">
      {{ patrocinador.nombre }}
    </h2>

    <div class="du-sponsor-detail__badges">

      {% if patrocinador.stand %}
        <span class="du-sponsor-detail__badge">
          <span aria-hidden="true">📍</span>
          Stand No. {{ patrocinador.stand }}
        </span>
      {% endif %}

      {% if patrocinador.piso %}
        <span class="du-sponsor-detail__badge">
          <span aria-hidden="true">🏢</span>
          {{ patrocinador.piso }}
        </span>
      {% endif %}

      <span class="du-sponsor-detail__badge">
        <span aria-hidden="true">🎤</span>
        Simposios vinculados:
        {{ patrocinador.simposios_count }}
      </span>

    </div>

    {% if patrocinador.descripcion %}
      <div class="du-sponsor-detail__description">
        {{ patrocinador.descripcion|nl2br }}
      </div>
    {% endif %}

  </header>

  <section class="du-sponsor-detail__section">
    <h3 class="du-sponsor-detail__section-title">
      Simposios Vinculados
    </h3>

    {% if patrocinador.simposios %}
      <div class="du-sponsor-detail__symposiums">

        {% for simposio in patrocinador.simposios %}
          <a
            href="{{ simposio.url }}"
            class="du-sponsor-symposium"
          >
            <div class="du-sponsor-symposium__tags">

              <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--sponsored">
                Simp. Patrocinado
              </span>

              {% if simposio.tematica %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--topic">
                  {{ simposio.tematica }}
                </span>
              {% endif %}

              {% if simposio.sala %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--room {{ simposio.sala_class }}">
                  {{ simposio.sala }}
                </span>
              {% endif %}

              {% if simposio.fecha %}
                <span class="du-sponsor-symposium__tag du-sponsor-symposium__tag--date">
                  {{ simposio.fecha }}
                </span>
              {% endif %}

              {% if simposio.hora %}
                <span class="du-sponsor-symposium__time">
                  <span class="du-icon__clock" aria-hidden="true"></span>
                  {{ simposio.hora }}
                </span>
              {% endif %}

            </div>

            <div class="du-sponsor-symposium__title">
              <strong>Conferencia:</strong>
              {{ simposio.nombre }}
            </div>
          </a>
        {% endfor %}

      </div>
    {% else %}
      <p class="du-sponsor-detail__empty">
        No tiene simposios vinculados.
      </p>
    {% endif %}
  </section>

  <section class="du-sponsor-detail__section">
    <h3 class="du-sponsor-detail__section-title">
      Conferencistas Vinculados
    </h3>

    {% if patrocinador.docentes %}
      <div class="du-sponsor-detail__teachers">

        {% for docente in patrocinador.docentes %}
          <article class="du-sponsor-teacher">

            <div class="du-sponsor-teacher__header">

              <div class="du-sponsor-teacher__photo">
                {% if docente.foto.url %}
                  <img
                    src="{{ docente.foto.url }}"
                    alt="{{ docente.foto.alt }}"
                    loading="lazy"
                  >
                {% else %}
                  <div class="du-sponsor-teacher__placeholder">
                    {{ docente.nombre|slice(0, 1)|upper }}
                  </div>
                {% endif %}
              </div>

              <div class="du-sponsor-teacher__identity">
                <h4 class="du-sponsor-teacher__name">
                  {{ docente.nombre }}
                </h4>

                {% if docente.especialidad %}
                  <div class="du-sponsor-teacher__specialty">
                    {{ docente.especialidad }}
                  </div>
                {% endif %}
              </div>

            </div>

            {% if docente.perfil_resumen %}
              <p class="du-sponsor-teacher__profile">
                {{ docente.perfil_resumen }}
              </p>
            {% endif %}

            <a
              href="{{ docente.url }}"
              class="du-sponsor-teacher__link"
            >
              Ver detalle
            </a>

          </article>
        {% endfor %}

      </div>
    {% else %}
      <p class="du-sponsor-detail__empty">
        No tiene conferencistas vinculados.
      </p>
    {% endif %}
  </section>

  {% if patrocinador.ubicacion.url %}
    <section class="du-sponsor-detail__section">
      <h3 class="du-sponsor-detail__section-title">
        Ubicación stand
      </h3>

      <div class="du-sponsor-detail__location">
        <img
          src="{{ patrocinador.ubicacion.url }}"
          alt="{{ patrocinador.ubicacion.alt }}"
          loading="lazy"
        >
      </div>
    </section>
  {% endif %}

</article>
