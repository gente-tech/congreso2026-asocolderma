{# ============================================================
   DATOS DEL CONGRESO
   ============================================================ #}
{% set dias_cortos = {
  'Monday': 'LUN',
  'Tuesday': 'MAR',
  'Wednesday': 'MIÉ',
  'Thursday': 'JUE',
  'Friday': 'VIE',
  'Saturday': 'SÁB',
  'Sunday': 'DOM'
} %}

{% set meses_cortos = {
  'January': 'ENE',
  'February': 'FEB',
  'March': 'MAR',
  'April': 'ABR',
  'May': 'MAY',
  'June': 'JUN',
  'July': 'JUL',
  'August': 'AGO',
  'September': 'SEP',
  'October': 'OCT',
  'November': 'NOV',
  'December': 'DIC'
} %}

  
<section class="du-congreso-section-hero">
  <div class="du-congreso__container  container">
    <div class="du-congreso-section-hero__left">
      <img class="logo" src="/sites/default/files/2026-06/logo-congreso7.png" alt="logo congreso 7">
      <div class="du-btn-tag">Evento Académico</div>
      <h1 class="du-congreso__title"> <span class="du-congreso__blink">{{ node.field_edicion_congreso.value ?? '' }}</span> {{ node.field_titulo_congreso.value }}</h1>
      <div class="du-congreso-actions">
        <a href="{{ node.field_boton_inscripcion.uri }}" class="du-btn min300 du-btn--primary">{{ node.field_boton_inscripcion.title }}</a>
      </div>
    </div>
    <div class="du-congreso-section-hero__right">
      <div  class="du-congreso-section-hero__bg" style="background-image: url(/sites/default/files/2026-06/bg-reference.png)"></div>
      <div class="du-congreso-section-hero__overlay"></div>
      <div class="du-congreso-section-hero__wrapper">
        <h2 class="du-congreso__subtitle">{{ node.field_subtitulo_congreso.value }}</h2>
        <div class="du-congreso-section-hero__items"> <span class="du-icon__calendar"></span> <span>{{ node.field_fecha_congreso.value }}</span>  </div>
        <div class="du-congreso-section-hero__items"> <span class="du-icon__location"></span> <span>{{ node.field_lugar_congreso.value }}</span>  </div>
      </div>
      <img class="logo" src="/sites/default/files/2026-06/logo-congreso7-sm.png" alt="logo congreso 7">
      <div class="bg-rectangle">
        <img class="icon-down" src="/sites/default/files/2026-06/icon-down.png" alt="arrow down">
      </div>
    </div>
  </div>
</section>

{% set url_search = path('entity.node.canonical', {'node': node.id}) %}
{% set url_schedule = path('entity.node.canonical', {'node': 98}) %}

<section class="du-congreso-section-info">
  <div class="du-congreso__container container">

    <h2 class="du-congreso__title">
      Simposios y Agenda Académica
    </h2>

    <p class="du-congreso__description">
      Aprende de expertos internacionales reconocidos.
    </p>

    <div class="du-congreso-section-info__menu">
      <a
        href="{{ url_search }}"
        target="_self"
        class="du-btn-opt active"
      >
        <span class="du-icon__search"></span>
        Búsqueda avanzada
      </a>

      <a
        href="{{ url_schedule }}"
        target="_self"
        class="du-btn-opt"
      >
        <span class="du-icon__calendar"></span>
        Agenda académica
      </a>
    </div>

    {% set pdf_file = node.field_pdf_congreso.entity %}

    {% if pdf_file %}
      <div class="du-congreso-section-info__download">
        <a
          href="{{ file_url(pdf_file.uri.value) }}"
          class="du-btn-download"
          download="{{ pdf_file.filename.value }}"
          type="application/pdf"
          aria-label="Descargar programa completo del congreso"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M12 3V15"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M7 10L12 15L17 10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M5 20H19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>

          <span>Descargar programa completo</span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% set salas = {
                'sala_1': 'Sala 1',
                'sala_2': 'Sala 2',
                'sala_3': 'Sala 3'
              } 
%}
<section class="du-congreso-section-filter">
  <div class="du-congreso__container">
    <div class="du-congreso-section-filter__content">
      <div class="du-congreso-section-filter__header">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1.75286 0.75H17.7986C18.0646 0.75 18.3197 0.855658 18.5078 1.04373C18.6958 1.2318 18.8015 1.48689 18.8015 1.75286V3.3434C18.8015 3.60935 18.6958 3.86439 18.5077 4.05242L12.0753 10.4848C11.8872 10.6728 11.7815 10.9278 11.7815 11.1938V17.5168C11.7815 17.6693 11.7467 17.8197 11.6799 17.9567C11.613 18.0937 11.5158 18.2136 11.3956 18.3074C11.2754 18.4012 11.1354 18.4664 10.9863 18.4979C10.8372 18.5295 10.6828 18.5267 10.5349 18.4896L8.5292 17.9882C8.31233 17.9339 8.11984 17.8086 7.98229 17.6324C7.84475 17.4561 7.77004 17.239 7.77003 17.0154V11.1938C7.76997 10.9278 7.66428 10.6728 7.47619 10.4848L1.04384 4.05242C0.855752 3.86439 0.750057 3.60935 0.75 3.3434V1.75286C0.75 1.48689 0.855658 1.2318 1.04373 1.04373C1.2318 0.855658 1.48689 0.75 1.75286 0.75Z" stroke="#F07F16" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h3 class="du-congreso__subtitle">Filtrar Simposio</h3>
      </div>

      <div class="du-congreso-section-filter__options">

        {# ---- SELECT: Tipo de evento (Simposio, Taller, etc.) ---- #}
        <select class="du-form-select" name="simposio" id="simposio">
          <option value="" selected="selected">Simposios</option>
          {% for evento_item in node.field_listado_eventos_congreso %}
            {% set evento = evento_item.entity %}
            {% set tipo = evento.field_tipo_evento.entity %}
            {% if tipo %}
              <option value="{{ tipo.tid.value }}">{{ tipo.name.value }}</option>
            {% endif %}
          {% endfor %}
        </select>

        {# ---- SELECT: Temática ---- #}
        <select class="du-form-select" name="tema" id="tema">
          <option value="" selected="selected">Temas</option>
          {% for evento_item in node.field_listado_eventos_congreso %}
            {% set evento = evento_item.entity %}
            {% set tematica = evento.field_tematica_evento.entity %}
            {% if tematica %}
              <option value="{{ tematica.tid.value }}">{{ tematica.name.value }}</option>
            {% endif %}
          {% endfor %}
        </select>

        {# ---- SELECT: Sala ---- #}
        <select class="du-form-select" name="sala" id="sala">
          <option value="" selected="selected">Salas</option>
          {% for evento_item in node.field_listado_eventos_congreso %}
            {% set evento = evento_item.entity %} 
            {% if evento.field_sala_evento.value %}
              <option value="{{ evento.field_sala_evento.value }}">{{ salas[evento.field_sala_evento.value] ?? evento.field_sala_evento.value }}</option>
            {% endif %}
          {% endfor %}
        </select>

        {# ---- SELECT: Conferencistas (desde los paragraphs) ---- #}
        <select
          class="du-form-select"
          name="conferencista"
          id="conferencista"
        >
          <option value="" selected="selected">
            Conferencistas
          </option>

          {% for evento_item in node.field_listado_eventos_congreso %}
            {% set evento = evento_item.entity %}

            {% for relacion_item in evento.field_conferencistas_del_evento %}
              {% set relacion = relacion_item.entity %}
              {% set docente = relacion.field_conferencista.entity %}

              {% if docente
                and docente.getEntityTypeId() == 'node'
                and docente.bundle() == 'docente'
              %}
                <option value="{{ docente.label }}">
                  {{ docente.label }}
                </option>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </select>

      </div>
    </div>
  </div>
</section>


{# ============================================================
   DATOS EVENTOS DEL CONGRESO
   ============================================================ #}

<section class="du-panel-block">
  <div class="du-panel-block__container">
    <div class="du-panel-block__wrapper">

      {% for evento_item in node.field_listado_eventos_congreso %}
        {% set evento = evento_item.entity %}
        {% set tipo = evento.field_tipo_evento.entity %}
        {% set tematica = evento.field_tematica_evento.entity %}
        {% set sala_key = evento.field_sala_evento.value %}
        {% set fecha_evento = evento.field_dia_evento.value %}

        {# Conferencistas válidos del evento #}
        {% set conferencistas_validos = [] %}
        {% set nombres_conferencistas = [] %}

        {% for relacion_item in evento.field_conferencistas_del_evento %}
          {% set relacion = relacion_item.entity %}
          {% set docente = relacion
            ? relacion.field_conferencista.entity
            : null
          %}

          {% if docente
            and docente.getEntityTypeId() == 'node'
            and docente.bundle() == 'docente'
          %}
            {% set pais = relacion.field_pais_conferencista.value|default('') %}

            {% set conferencistas_validos = conferencistas_validos|merge([{
              'id': docente.id(),
              'nombre': docente.label,
              'pais': pais
            }]) %}

            {% set nombres_conferencistas = nombres_conferencistas|merge([
              docente.label
            ]) %}
          {% endif %}
        {% endfor %}

        <article
          class="du-panel-block__item"
          id="simposio-{{ evento.id() }}"
          data-tipo="{{ tipo ? tipo.tid.value : '' }}"
          data-tematica="{{ tematica ? tematica.tid.value : '' }}"
          data-sala="{{ sala_key }}"
          data-conferencistas="{{ nombres_conferencistas|join('|') }}"
        >

          {# ====================================================
             CABECERA CON ETIQUETAS
             ==================================================== #}

          <button
            type="button"
            class="du-panel-block__trigger"
            aria-expanded="false"
          >
            <div class="du-panel-block__content">

              {% if tipo.tid.value %}
                <span
                  class="tag-outline tipoS"
                  data-tag="{{ tipo.tid.value }}"
                >
                  {{ tipo.name.value }}
                </span>
              {% endif %}

              {% if tematica.tid.value %}
                <span
                  class="tag-outline tipoT"
                  data-tag="{{ tematica.tid.value }}"
                >
                  {{ tematica.name.value }}
                </span>
              {% endif %}

              {% if sala_key %}
                <span
                  class="tag-solid {{ sala_key|replace({'_': '-'}) }} sala"
                >
                  {{ salas[sala_key]|default(sala_key) }}
                </span>
              {% endif %}

              {% if fecha_evento %}
                <span class="du-panel-block__date">
                  {{ dias_cortos[fecha_evento|date('l', 'UTC')] }}
                  {{ fecha_evento|date('j', 'UTC') }}
                  {{ meses_cortos[fecha_evento|date('F', 'UTC')] }}
                </span>
              {% endif %}

              {% if evento.field_hora_evento.from %}
                <div class="tag-flex">
                  <span
                    class="du-icon__clock"
                    aria-hidden="true"
                  ></span>

                  {{ evento.field_hora_evento.from|date('g:i', 'UTC') }}
                  -
                  {{ evento.field_hora_evento.to|date('g:i A', 'UTC') }}
                </div>
              {% endif %}

            </div>

            <div
              class="du-icon-trigger__plus"
              aria-hidden="true"
            ></div>
          </button>

          {# ====================================================
             RESUMEN VISIBLE EN LA CARD CERRADA
             ==================================================== #}

          <div class="du-panel-block__resumen">

            <h3 class="du-congreso__subtitle">
              {{ evento.title.value }}
            </h3>

            {% if evento.field_descripcion_evento.value %}
              <p class="du-congreso__description">
                {{ evento.field_descripcion_evento.value }}
              </p>
            {% endif %}

            {% if conferencistas_validos|length > 0 %}
              <div class="du-panel-block__resumen-speakers">
                <span
                  class="du-icon__micro"
                  aria-hidden="true"
                ></span>

                <strong>
                  {{ conferencistas_validos|length > 1
                    ? 'Conferencistas:'
                    : 'Conferencista:'
                  }}
                </strong>

                <div class="du-panel-block__speaker-list">
                  {% for conferencista in conferencistas_validos %}
                    <button
                      type="button"
                      class="du-panel-block__speaker js-conferencista-modal-open"
                      data-modal-target="conferencista-modal-{{ conferencista.id }}"
                      aria-haspopup="dialog"
                      aria-controls="conferencista-modal-{{ conferencista.id }}"
                    >
                      <span>
                        {{ conferencista.nombre }}
                      </span>

                      {% if conferencista.pais %}
                        <span
                          class="du-icon__flag-{{ conferencista.pais|lower|clean_class }}"
                          title="{{ conferencista.pais }}"
                          aria-label="{{ conferencista.pais }}"
                        ></span>
                      {% endif %}
                    </button>

                    {% if not loop.last %}
                      <span
                        class="du-panel-block__speaker-separator"
                        aria-hidden="true"
                      >
                        ,
                      </span>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

          </div>

          {# ====================================================
             CONTENIDO DE LA CARD ABIERTA
             ==================================================== #}

          <div
            class="du-panel-block__body"
            data-variation="resumen"
          >

            <div class="du-panel-block__detail">

              {% if conferencistas_validos|length > 0 %}
                <div class="du-panel-block__detail-item">
                  <span
                    class="du-icon__micro"
                    aria-hidden="true"
                  ></span>

                  <strong>
                    {{ conferencistas_validos|length > 1
                      ? 'Conferencistas:'
                      : 'Conferencista:'
                    }}
                  </strong>

                  <div class="du-panel-block__speaker-list">
                    {% for conferencista in conferencistas_validos %}
                      <button
                        type="button"
                        class="du-panel-block__speaker js-conferencista-modal-open"
                        data-modal-target="conferencista-modal-{{ conferencista.id }}"
                        aria-haspopup="dialog"
                        aria-controls="conferencista-modal-{{ conferencista.id }}"
                      >
                        <span>
                          {{ conferencista.nombre }}
                        </span>

                        {% if conferencista.pais %}
                          <span
                            class="du-icon__flag-{{ conferencista.pais|lower|clean_class }}"
                            title="{{ conferencista.pais }}"
                            aria-label="{{ conferencista.pais }}"
                          ></span>
                        {% endif %}
                      </button>

                      {% if not loop.last %}
                        <span
                          class="du-panel-block__speaker-separator"
                          aria-hidden="true"
                        >
                          ,
                        </span>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {% if evento.field_conferencistas_del_evento|length %}
                <div class="du-panel-block__detail-item">
                  <span
                    class="du-icon__micro"
                    aria-hidden="true"
                  ></span>

                  <strong>
                    {{ evento.field_conferencistas_del_evento|length > 1
                      ? 'Conferencistas:'
                      : 'Conferencista:'
                    }}
                  </strong>

                  <div class="du-panel-block__speaker-list">
                    {% for relacion_item in evento.field_conferencistas_del_evento %}
                      {% set relacion = relacion_item.entity %}
                      {% set docente = relacion.field_conferencista.entity %}
                      {% set pais = relacion.field_pais_conferencista.value|default('') %}

                      {% if docente %}
                        <button
                          type="button"
                          class="du-panel-block__speaker js-conferencista-modal-open"
                          data-modal-target="conferencista-modal-{{ docente.id() }}"
                          aria-haspopup="dialog"
                          aria-controls="conferencista-modal-{{ docente.id() }}"
                        >
                          <span>
                            {{ docente.label }}
                          </span>

                          {% if pais %}
                            <span
                              class="du-icon__flag-{{ pais|clean_class }}"
                              title="{{ pais }}"
                              aria-label="{{ pais }}"
                            ></span>
                          {% endif %}
                        </button>

                        {% if not loop.last %}
                          <span
                            class="du-panel-block__speaker-separator"
                            aria-hidden="true"
                          >
                            ,
                          </span>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

            </div>

            {# ==================================================
               CONFERENCIAS INTERNAS DEL EVENTO
               ================================================== #}

            <div class="du-panel-block__desglose">
              {% for conf_item in evento.field_listado_conferencias %}
                {% set conferencia = conf_item.entity %}
                {% set docente_conferencia = conferencia.field_conferencista_conferencia.0.entity %}

                <div class="du-panel-block__desglose-item">

                  {% if conferencia.field_hora_conferencia.value %}
                    <div class="tag-flex">
                      <span
                        class="du-icon__clock"
                        aria-hidden="true"
                      ></span>

                      {{ conferencia.field_hora_conferencia.value }}
                    </div>
                  {% endif %}

                  <h3>
                    <span class="blink">Conferencia:</span>
                    {{ conferencia.field_titulo_conferencia.value }}
                  </h3>

                  {% if conferencia.field_descripcion_conferencia.value %}
                    <p>
                      {{ conferencia.field_descripcion_conferencia.value }}
                    </p>
                  {% endif %}

                  {% if docente_conferencia %}
                    <div class="du-panel-block__detail-item">
                      <span class="blink">
                        Conferencista:
                      </span>

                      <span>
                        {{ docente_conferencia.title.value }}
                      </span>

                      {% if conferencia.field_pais_conferencista.value %}
                        <span
                          class="du-icon__flag-{{ conferencia.field_pais_conferencista.value|lower|clean_class }}"
                          title="{{ conferencia.field_pais_conferencista.value }}"
                          aria-label="{{ conferencia.field_pais_conferencista.value }}"
                        ></span>
                      {% endif %}
                    </div>
                  {% endif %}

                </div>
              {% endfor %}
            </div>

            <div class="du-panel-block__top">
              <a
                href="#simposio-{{ evento.id() }}"
                class="du-icon__top"
                aria-label="Volver al inicio del simposio"
              ></a>
            </div>

          </div>
        </article>
      {% endfor %}

    </div>
  </div>
</section>

{# ============================================================
   DOCENTES ÚNICOS DE LA PÁGINA
   ============================================================ #}

{% set docentes_popup = {} %}

{% for evento_item in node.field_listado_eventos_congreso %}
  {% set evento_popup = evento_item.entity %}

  {% for relacion_item in evento_popup.field_conferencistas_del_evento %}
    {% set relacion = relacion_item.entity %}
    {% set docente = relacion.field_conferencista.entity %}

    {% if docente
      and docente.getEntityTypeId() == 'node'
      and docente.bundle() == 'docente'
    %}
      {% set docente_key = 'docente_' ~ docente.id() %}

      {% if docentes_popup[docente_key] is not defined %}
        {% set docentes_popup = docentes_popup|merge({
          (docente_key): {
            'docente': docente,
            'pais': relacion.field_pais_conferencista.value|default('')
          }
        }) %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endfor %}

{# ============================================================
   POPUPS
   ============================================================ #}

{% for docente_popup in docentes_popup %}
  {% set docente = docente_popup.docente %}
  {% set pais = docente_popup.pais %}
  {% set foto_item = docente.field_foto_docente.0 %}
  {% set foto_archivo = foto_item.entity %}
  {% set especialidad = docente.field_especialidad.entity %}

  <dialog
    id="conferencista-modal-{{ docente.id() }}"
    class="du-conferencista-modal"
    aria-labelledby="conferencista-modal-title-{{ docente.id() }}"
  >
    <div class="du-conferencista-modal__surface">

      <button
        type="button"
        class="du-conferencista-modal__close"
        data-modal-close
        aria-label="Cerrar información de {{ docente.label }}"
      >
        <span aria-hidden="true">×</span>
      </button>

      <div class="du-conferencista-modal__layout">

        <aside class="du-conferencista-modal__identity">

          <div class="du-conferencista-modal__photo">
            {% if foto_archivo %}
              <img
                src="{{ file_url(foto_archivo.uri.value) }}"
                alt="{{ foto_item.alt|default(docente.label) }}"
                loading="lazy"
                width="{{ foto_item.width|default(400) }}"
                height="{{ foto_item.height|default(500) }}"
              >
            {% else %}
              <div class="du-conferencista-modal__photo-placeholder">
                {{ docente.label|slice(0, 1)|upper }}
              </div>
            {% endif %}
          </div>

          <h2
            id="conferencista-modal-title-{{ docente.id() }}"
            class="du-conferencista-modal__name"
          >
            {{ docente.label }}
          </h2>

          {% if especialidad %}
            <div class="du-conferencista-modal__specialty">
              {{ especialidad.label }}
            </div>
          {% endif %}

        </aside>

        <div class="du-conferencista-modal__content">

          <section class="du-conferencista-modal__section">

            <h3 class="du-conferencista-modal__section-title">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 10L12 5L21 10L12 15L3 10Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path
                  d="M7 12V17C10 19 14 19 17 17V12"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
                <path
                  d="M21 10V16"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>

              Perfil profesional
            </h3>

            {% if docente.field_perfil_profesional.value %}
              <div class="du-conferencista-modal__profile">
                {{ docente.field_perfil_profesional.value|nl2br }}
              </div>
            {% else %}
              <p class="du-conferencista-modal__empty">
                Perfil profesional no disponible.
              </p>
            {% endif %}

          </section>

          <section class="du-conferencista-modal__section">

            <h3 class="du-conferencista-modal__section-title du-conferencista-modal__section-title--conferences">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 5.5C4 4.67 4.67 4 5.5 4H11V19H5.5C4.67 19 4 19.67 4 20.5V5.5Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path
                  d="M20 5.5C20 4.67 19.33 4 18.5 4H13V19H18.5C19.33 19 20 19.67 20 20.5V5.5Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>

              Conferencias vinculadas
            </h3>

            <div class="du-conferencista-modal__events">
              {% set tiene_conferencias_vinculadas = false %}

              {% for evento_item in node.field_listado_eventos_congreso %}
                {% set evento_vinculado = evento_item.entity %}

                {% if evento_vinculado %}
                  {% set tipo_vinculado = evento_vinculado.field_tipo_evento.entity %}
                  {% set tematica_vinculada = evento_vinculado.field_tematica_evento.entity %}
                  {% set sala_vinculada = evento_vinculado.field_sala_evento.value %}
                  {% set fecha_vinculada = evento_vinculado.field_dia_evento.value %}

                  {% for conferencia_item in evento_vinculado.field_listado_conferencias %}
                    {% set conferencia_vinculada = conferencia_item.entity %}

                    {% if conferencia_vinculada %}
                      {% set docente_conferencia = conferencia_vinculada.field_conferencista_conferencia.0.entity %}

                      {% if docente_conferencia and docente_conferencia.id() == docente.id() %}
                        {% set tiene_conferencias_vinculadas = true %}

                        <a
                          href="#simposio-{{ evento_vinculado.id() }}"
                          class="du-conferencista-event js-conferencista-event-link"
                        >
                          <div class="du-conferencista-event__tags">

                            {% if tipo_vinculado %}
                              <span class="du-conferencista-event__tag">
                                {{ tipo_vinculado.name.value }}
                              </span>
                            {% endif %}

                            {% if tematica_vinculada %}
                              <span class="du-conferencista-event__tag du-conferencista-event__tag--orange">
                                {{ tematica_vinculada.name.value }}
                              </span>
                            {% endif %}

                            {% if sala_vinculada %}
                              <span class="du-conferencista-event__tag du-conferencista-event__tag--room">
                                {{ salas[sala_vinculada]|default(sala_vinculada) }}
                              </span>
                            {% endif %}

                            {% if fecha_vinculada %}
                              <span class="du-conferencista-event__date">
                                {{ dias_cortos[fecha_vinculada|date('l', 'UTC')] }}
                                {{ fecha_vinculada|date('j', 'UTC') }}
                                {{ meses_cortos[fecha_vinculada|date('F', 'UTC')] }}
                              </span>
                            {% endif %}

                            {% if conferencia_vinculada.field_hora_conferencia.value %}
                              <span class="du-conferencista-event__time">
                                <span
                                  class="du-icon__clock"
                                  aria-hidden="true"
                                ></span>

                                {{ conferencia_vinculada.field_hora_conferencia.value }}
                              </span>
                            {% endif %}

                          </div>

                          <div class="du-conferencista-event__title">
                            <strong>Conferencia:</strong>
                            {{ conferencia_vinculada.field_titulo_conferencia.value }}
                          </div>
                        </a>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}

              {% if not tiene_conferencias_vinculadas %}
                <p class="du-conferencista-modal__empty">
                  Sin conferencias vinculadas
                </p>
              {% endif %}
            </div>

          </section>

        </div>
      </div>
    </div>
  </dialog>
{% endfor %}

