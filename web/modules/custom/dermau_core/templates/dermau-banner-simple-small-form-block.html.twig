<section class="du-hero" data-variation="medium">
	<div class="du-hero__container">
		<div class="du-hero__bg" style="background-image: url({{ imagen.url }});"></div>
		<div class="du-hero__overlay"></div>
		<div class="du-hero__wrapper">
			<div class="du-hero__content">
				<h1 class="du-hero__title">
					{% if titulo_color %}
						<span>{{ titulo_color }}</span>
					{% endif %}
					{% if titulo_normal %}
						{{ titulo_normal }}
					{% endif %}
				</h1>
				{% if descripcion %}
					<div class="du-hero__text">
						<p class="du-banner-simple-small-form__description">
							{{ descripcion }}
						</p>
					</div>
				{% endif %}
				{% if label_btn and url_btn %}
					<div class="du-hero__actions">
						<a href="{{ url_btn }}" class="du-btn du-btn--primary">{{ label_btn }}
							<span class="du-icon__next"></span>
						</a>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>
