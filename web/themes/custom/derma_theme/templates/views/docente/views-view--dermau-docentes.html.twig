{{ attach_library('derma_theme/docentes-filter') }}
{%
  set classes = [
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

<div{{attributes.addClass(classes)}}>
	{{ title_prefix }}

	{% if title %}
		{{ title }}
	{% endif %}

	{{ title_suffix }}

	{% if header %}
		{{ header }}
	{% endif %}

	<div class="du-docentes-view-menu">
		<div class="du-congreso-section-info__menu">

			<a href="{{ path('entity.node.canonical', {'node': 97}) }}" class="du-btn-opt">
				<span class="du-icon__search"></span>
				Búsqueda avanzada
			</a>

			<a href="{{ path('view.dermau_docentes.page_1') }}" class="du-btn-opt active" aria-current="page">
				<svg width="20" height="20" viewbox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M9 18h6M10 22h4M8.5 14.5C7.56 13.65 7 12.42 7 11a5 5 0 0 1 10 0c0 1.42-.56 2.65-1.5 3.5-.78.71-1.5 1.52-1.5 2.5h-4c0-.98-.72-1.79-1.5-2.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
				Conferencistas
			</a>

		</div>
	</div>

	<nav class="du-docentes-tabs" aria-label="Tipo de conferencista">
		<div class="du-docentes-tabs__container" role="tablist">

			<button type="button" class="du-docentes-tabs__button{{ tipo_conferencista == 'internacional' ? ' active' : '' }}" data-tipo-conferencista="internacional" role="tab" aria-selected="{{ tipo_conferencista == 'internacional' ? 'true' : 'false' }}">
				Internacionales
			</button>

			<span class="du-docentes-tabs__divider" aria-hidden="true"></span>

			<button type="button" class="du-docentes-tabs__button{{ tipo_conferencista == 'nacional' ? ' active' : '' }}" data-tipo-conferencista="nacional" role="tab" aria-selected="{{ tipo_conferencista == 'nacional' ? 'true' : 'false' }}">
				Nacionales
			</button>

		</div>
	</nav>

	{% if exposed %}
		{{ exposed }}
	{% endif %}

	{% if attachment_before %}
		{{ attachment_before }}
	{% endif %}

	{% if rows %}
		{{ rows }}
	{% elseif empty %}
		{{ empty }}
	{% endif %}

	{% if pager %}
		<div class="du-pagination">
			{{ pager }}
		</div>
	{% endif %}

	{% if attachment_after %}
		{{ attachment_after }}
	{% endif %}

	{% if more %}
		{{ more }}
	{% endif %}

	{% if footer %}
		{{ footer }}
	{% endif %}

	{% if feed_icons %}
		{{ feed_icons }}
	{% endif %}
</div>
