{{ attach_library('derma_theme/global') }}

{% include '@derma_theme/includes/header.html.twig' %}

<main class="du-main du-error-page">

	<section class="du-error-404">

		<div class="du-error-404__container">

			<div class="du-error-404__content">

				<div class="du-error-404__code" aria-label="Error 404">

					<span class="du-error-404__number">
						4
					</span>

					<span class="du-error-404__symbol" aria-hidden="true">
						<img src="{{ base_path ~ directory }}/assets/img/logo-congreso7-sm.png" alt="">
